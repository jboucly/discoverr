# --- Paths (host side) ---
# Your music folder (the one holding Decouvertes/ and the liked tracks folder)
MUSIC_DIR=/mnt/media/Musiques
# The same folder as Plex sees it (inside the Plex container)
PLEX_MUSIC_ROOT=/media/Musiques
# Container data (SQLite database, session…)
APPDATA=./appdata

# --- discoverr ---
# UI password (empty = open UI, not recommended)
DISCOVERR_PASSWORD=
# Key for scripts (X-Api-Key header), optional
DISCOVERR_API_KEY=
# First boot: "Moi" profile created with this Last.fm account, in dry-run mode
LASTFM_USER=
DISCOVERR_DRY_RUN=true

# --- Services ---
# https://www.last.fm/api/account/create
LASTFM_API_KEY=
# Plex admin token
PLEX_TOKEN=

# --- pickarr-discovery ---
PICKARR_PASSWORD=
# Key shared by pickarr-discovery and discoverr: openssl rand -hex 24
DISCOVERY_PICKARR_API_KEY=

# --- Soulseek (optional) ---
SLSKD_URL=
SLSKD_API_KEY=
SOULSEEK_DOWNLOADS=
