# --- Chemins (côté hôte) ---
# Ton dossier de musique (celui qui contient Decouvertes/ et le dossier des titres aimés)
MUSIC_DIR=/mnt/media/Musiques
# Le même dossier tel que Plex le voit (dans le container Plex)
PLEX_MUSIC_ROOT=/media/Musiques
# Données des containers (base SQLite, session…)
APPDATA=./appdata

# --- discoverr ---
# Mot de passe de l'interface (vide = interface ouverte, déconseillé)
DISCOVERR_PASSWORD=
# Clé pour les scripts (en-tête X-Api-Key), facultative
DISCOVERR_API_KEY=
# Premier démarrage : profil « Moi » créé avec ce compte Last.fm, en mode simulation
LASTFM_USER=
DISCOVERR_DRY_RUN=true

# --- Services ---
# https://www.last.fm/api/account/create
LASTFM_API_KEY=
# Jeton Plex administrateur
PLEX_TOKEN=

# --- pickarr-discovery ---
PICKARR_PASSWORD=
# Clé partagée entre pickarr-discovery et discoverr : openssl rand -hex 24
DISCOVERY_PICKARR_API_KEY=

# --- Soulseek (facultatif) ---
SLSKD_URL=
SLSKD_API_KEY=
SOULSEEK_DOWNLOADS=
