# Lancement local de l'API (npm run build && npm start dans api/), chargé via --env-file-if-exists=.env.
# Copie ce fichier en api/.env et remplis-le. Pour Docker, voir le .env.example à la racine.
# Les chemins relatifs partent de api/.

# --- discoverr ---
PORT=3000
# Vide = interface ouverte (acceptable en local)
DISCOVERR_PASSWORD=
DISCOVERR_API_KEY=
# Base SQLite et clé de session
DATA_DIR=../appdata/local/data

# --- Last.fm ---
# https://www.last.fm/api/account/create
LASTFM_API_KEY=
# Premier démarrage : crée le profil « Moi » avec ce compte
LASTFM_USER=

# --- Plex ---
PLEX_URL=http://192.168.1.33:32400
# Jeton administrateur
PLEX_TOKEN=

# --- pickarr ---
# Inutile en simulation : il n'est appelé qu'au téléchargement
PICKARR_URL=http://localhost:8090
PICKARR_API_KEY=local
PICKARR_LIBRARY_SUBDIR=Decouvertes

# --- Chemins ---
# Le dossier de musique vu par discoverr (en local : un dossier factice)
MUSIC_ROOT=../appdata/local/music
# Le même dossier vu par Plex
PLEX_MUSIC_ROOT=/media/Musiques
DISCOVERY_SUBDIR=Decouvertes

# --- Premier démarrage seulement ---
# Simulation : rien n'est téléchargé, déplacé ni supprimé
DRY_RUN=true
# Facultatif
DISCORD_WEBHOOK_URL=
