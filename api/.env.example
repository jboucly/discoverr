# Local API run (npm run build && npm start in api/), loaded through --env-file-if-exists=.env.
# Copy this file to api/.env and fill it in. For Docker, see the .env.example at the root.
# Relative paths start from api/.

# --- discoverr ---
PORT=3000
# Empty = open UI (fine locally)
DISCOVERR_PASSWORD=
DISCOVERR_API_KEY=
# SQLite database and session key
DATA_DIR=../appdata/local/data

# --- Last.fm ---
# https://www.last.fm/api/account/create
LASTFM_API_KEY=
# First boot: creates the "Moi" profile with this account
LASTFM_USER=

# --- Plex ---
PLEX_URL=http://<PLEX_HOST>:32400
# Admin token
PLEX_TOKEN=

# --- pickarr ---
# Not needed in dry-run mode: only called when downloading
PICKARR_URL=http://localhost:8090
PICKARR_API_KEY=local
PICKARR_LIBRARY_SUBDIR=Decouvertes

# --- Paths ---
# The music folder as discoverr sees it (locally: a dummy folder)
MUSIC_ROOT=../appdata/local/music
# The same folder as Plex sees it
PLEX_MUSIC_ROOT=/media/Musiques
DISCOVERY_SUBDIR=Decouvertes

# --- First boot only ---
# Dry run: nothing is downloaded, moved or deleted
DRY_RUN=true
# Optional
DISCORD_WEBHOOK_URL=
