{
  "name": "discoverr-api",
  "version": "2.0.0",
  "license": "GPL-3.0-only",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning dist/main.js",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "rm -rf dist-test && tsc -p tsconfig.test.json && node --test --disable-warning=ExperimentalWarning \"dist-test/test/**/*.spec.js\""
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/static": "10.1.6",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-fastify": "11.2.7",
    "@nestjs/schedule": "6.1.3",
    "cron": "4.4.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "ytmusic-api": "5.3.1"
  },
  "devDependencies": {
    "@types/node": "22.15.0",
    "typescript": "5.9.3"
  }
}
